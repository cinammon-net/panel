#!/bin/bash
# cinammon.net: publish web hosting servers behind Cloudflare and hide their IP:port.
#  1. asks the panel which servers are websites (php artisan sites:export)
#  2. writes the nginx host map /etc/nginx/cinammon-sites.map and reloads nginx if it changed
#  3. drops direct Internet access to those containers' ports (iptables chain CINAMMON-SITES,
#     jumped from DOCKER-USER, because Docker-published ports bypass ufw)
# Runs every minute from cinammon-sites-sync.timer. Safe to run by hand.
set -euo pipefail

PANEL=/var/www/cinammon-panel
MAP=/etc/nginx/cinammon-sites.map
STATE=/var/lib/cinammon/sites-ports
CHAIN=CINAMMON-SITES

json=$(cd "$PANEL" && sudo -u www-data env HOME=/tmp XDG_CONFIG_HOME=/tmp php8.4 artisan sites:export 2>/dev/null | tail -n 1) || {
  echo "sites:export failed; leaving current config" >&2; exit 1; }

tmpmap=$(mktemp); tmpports=$(mktemp)
trap 'rm -f "$tmpmap" "$tmpports"' EXIT

JSON="$json" python3 -I - "$tmpmap" "$tmpports" <<'PY'
import ipaddress, json, os, re, sys
sites = json.loads(os.environ["JSON"] or "[]")
host_re = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.cinammon\.net$")
lines, ports = [], set()
for s in sites:
    host, ip, port = str(s.get("host", "")).lower(), str(s.get("ip", "")), s.get("port")
    if not host_re.match(host) or not isinstance(port, int) or not 1 <= port <= 65535:
        continue
    try:
        ipaddress.ip_address(ip)
    except ValueError:
        continue
    lines.append(f"{host} {ip}:{port};")
    ports.add(port)
with open(sys.argv[1], "w") as f:
    f.write("# generated by cinammon-sites-sync, do not edit\n" + "\n".join(sorted(lines)) + "\n")
with open(sys.argv[2], "w") as f:
    f.write("\n".join(str(p) for p in sorted(ports)) + ("\n" if ports else ""))
PY

# nginx map
if ! cmp -s "$tmpmap" "$MAP"; then
  [ -f "$MAP" ] && cp -a "$MAP" "$MAP.prev"
  install -m 644 "$tmpmap" "$MAP"
  if nginx -t >/dev/null 2>&1; then
    systemctl reload nginx
    echo "nginx map updated: $(grep -vc '^#' "$MAP") site(s)"
  else
    echo "nginx -t failed, restoring previous map" >&2
    [ -f "$MAP.prev" ] && cp -a "$MAP.prev" "$MAP"
    exit 1
  fi
fi

# firewall: block direct Internet access to website containers
iface=$(ip route show default | awk '{print $5; exit}')
iptables -N "$CHAIN" 2>/dev/null || true
iptables -N DOCKER-USER 2>/dev/null || true
iptables -C DOCKER-USER -j "$CHAIN" 2>/dev/null || iptables -I DOCKER-USER 1 -j "$CHAIN"
want=$(cat "$tmpports"); have=$(cat "$STATE" 2>/dev/null || true)
chain_empty=0
iptables -S "$CHAIN" | grep -q -- "-A $CHAIN" || chain_empty=1
# rebuild when the port list changed, or after a reboot/firewall reset emptied the chain
if [ "$want" != "$have" ] || { [ -n "$want" ] && [ "$chain_empty" = 1 ]; }; then
  iptables -F "$CHAIN"
  for p in $want; do
    iptables -A "$CHAIN" -i "$iface" -p tcp -m conntrack --ctorigdstport "$p" -j DROP
    iptables -A "$CHAIN" -i "$iface" -p udp -m conntrack --ctorigdstport "$p" -j DROP
  done
  mkdir -p "$(dirname "$STATE")"; printf '%s' "$want" > "$STATE"
  echo "direct access blocked on ports: ${want:-none}" | tr '\n' ' '; echo
fi
